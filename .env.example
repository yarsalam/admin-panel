# Copy this file to .env and replace every placeholder before starting.
# Never commit the real .env file.

# Local development defaults
NODE_ENV=development
PORT=4000
ADMIN_WEB_ORIGINS=http://localhost:3000,http://192.168.0.133:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin database. Use a unique password; do not reuse production credentials.
ADMIN_DB_ROOT_PASSWORD=
ADMIN_DB_USER=admin_app
ADMIN_DB_PASSWORD=
DB_SYNC=true

# Required JWT signing secret. Generate a long random value, e.g. with:
# openssl rand -base64 48
JWT_SECRET=

# Optional one-time bootstrap account. Use a unique password of at least 16 characters.
# After the account is created, remove INITIAL_ADMIN_PASSWORD from .env.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Internal connection to the Yarsalam user backend.
USER_API_BASE_URL=http://backend:5000
# Must match INTERNAL_API_KEY configured in the mobApp backend.
USER_API_KEY=
