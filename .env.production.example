# Copy to .env.production and replace every CHANGE_ME value before deployment.
NODE_ENV=production

# Admin database (separate from the user/backend database)
ADMIN_DB_ROOT_PASSWORD=CHANGE_ME_long_random_root_password
ADMIN_DB_NAME=admin_yarsalam
ADMIN_DB_USER=admin_app
ADMIN_DB_PASSWORD=CHANGE_ME_long_random_admin_db_password

# Authentication and internal Backend API access
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
USER_API_BASE_URL=http://backend:5000
USER_API_KEY=CHANGE_ME_must_equal_backend_INTERNAL_API_KEY

# First startup only: create the initial superadmin. Remove the password after bootstrap.
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_at_least_16_random_characters

# Browser origin allowed to call the Admin API
ADMIN_CORS_ORIGINS=https://admin.example.com

# Public URL compiled into the Next.js browser bundle
NEXT_PUBLIC_API_URL=https://admin-api.example.com

# Database schema synchronization is not a migration strategy.
# Keep false for persistent environments; this repo still needs an initial migration.
DB_SYNC=false
DB_LOGGING=false
