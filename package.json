{
  "name": "admin-panel",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt"
    ],
    "overrides": {
      "brace-expansion@1.1.15": "1.1.21",
      "brace-expansion@2.0.2": "2.1.7",
      "brace-expansion@2.1.1": "2.1.7",
      "brace-expansion@5.0.6": "5.0.11",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.9",
      "ip-address": "10.3.1",
      "nanoid@3": "3.3.18",
      "nanoid@5": "5.1.16",
      "picomatch": "4.0.4",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "postcss": "8.5.23"
    }
  }
}
