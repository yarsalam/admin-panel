{
  "name": "admin-panel",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt"
    ],
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^2.0.0": "2.1.7",
      "brace-expansion@^5.0.0": "5.0.10",
      "fast-uri": "3.1.9",
      "sharp": "0.35.5"
    }
  }
}
